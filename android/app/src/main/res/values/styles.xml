<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema escuro usado enquanto o Flutter está iniciando. -->
    <style
        name="LaunchTheme"
        parent="Theme.AppCompat.DayNight.NoActionBar">

        <item name="android:windowBackground">
            @drawable/launch_background
        </item>

        <item name="android:windowNoTitle">true</item>

        <!-- Mantém o aplicativo atrás das barras do sistema. -->
        <item name="android:windowDrawsSystemBarBackgrounds">
            true
        </item>

        <item name="android:statusBarColor">
            @android:color/transparent
        </item>

        <item name="android:navigationBarColor">
            @android:color/transparent
        </item>

        <!-- Ícones claros no modo escuro. -->
        <item name="android:windowLightStatusBar">
            false
        </item>

        <item name="android:windowLightNavigationBar">
            false
        </item>

        <!-- Permite utilizar a área próxima ao recorte da tela. -->
        <item name="android:windowLayoutInDisplayCutoutMode">
            shortEdges
        </item>
    </style>

    <!-- Tema utilizado depois que o Flutter já carregou. -->
    <style
        name="NormalTheme"
        parent="Theme.AppCompat.DayNight.NoActionBar">

        <item name="android:windowBackground">
            ?android:colorBackground
        </item>

        <item name="android:windowNoTitle">true</item>

        <item name="android:windowDrawsSystemBarBackgrounds">
            true
        </item>

        <item name="android:statusBarColor">
            @android:color/transparent
        </item>

        <item name="android:navigationBarColor">
            @android:color/transparent
        </item>

        <item name="android:windowLightStatusBar">
            false
        </item>

        <item name="android:windowLightNavigationBar">
            false
        </item>

        <item name="android:windowLayoutInDisplayCutoutMode">
            shortEdges
        </item>
    </style>

</resources>